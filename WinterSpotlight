local Lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Hosvile/Refinement/main/UI-th%20Library%20v0.1.2"))()

local window = Lib:CreateWindow("Winter Spotlight scripts UI")
local tab = window:CreateTab("Main")

local items = {
    { name = "Royale High", id = ""loadstring(game:HttpGet(""https://raw.githubusercontent.com/ToraScript/Script/main/RoyaleHighWinter"" }
}

game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Welcome!"; Text = "Most scripts made by ToraIs Me"; Icon = "rbxthumb://type=Asset&id=17834951927&w=150&h=150"}) Duration = 5;

local itemNames = {}
for i, item in ipairs(items) do
    table.insert(itemNames, item.name)
end

tab:CreateDropdown("select script", itemNames, function(selectedName)
    for i, item in ipairs(items) do
        if item.name == selectedName then
            selectedItem = tonumber(item.id)
            break
        end
    end
end)

tab:CreateButton("execute script", function()
    if selectedItem then
        loadstring(game:HttpGet(selectedItem))()
    end
end)
